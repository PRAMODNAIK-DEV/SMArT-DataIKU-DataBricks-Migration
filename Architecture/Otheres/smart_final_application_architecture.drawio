<mxfile host="app.diagrams.net">
  <diagram name="SMArT Final Application Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="users" value="Users / Business Users" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="app" value="Databricks Apps" style="swimlane;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="120" width="400" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="react" value="React Frontend" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="app">
          <mxGeometry x="20" y="40" width="150" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="flask" value="Flask Backend APIs" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="app">
          <mxGeometry x="220" y="40" width="150" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="sql" value="Databricks SQL Warehouse" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="350" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="uc" value="Unity Catalog&#xa;RBAC / Governance / Service Principals / Secrets" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="460" width="340" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="delta" value="Delta Lake" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="610" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" source="users" target="app" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" source="react" target="flask" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" source="app" target="sql" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" source="sql" target="uc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" source="uc" target="delta" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>